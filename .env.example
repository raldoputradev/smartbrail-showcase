APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_IDLE_MINUTES=30
SESSION_IDLE_WARN_MINUTES=2
SESSION_ABSOLUTE_HOURS=8
SESSION_GUARD_ENABLED=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_CONNECT_TIMEOUT=1
REVERB_TIMEOUT=2
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=15
MAIL_EHLO_DOMAIN=null
MAIL_ENCRYPTION=tls

# Linux VPS: path PHP CLI untuk kirim OTP async (contoh: /usr/bin/php8.3)
# PHP_CLI_BIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google reCAPTCHA v2 (checkbox) — https://www.google.com/recaptcha/admin
# Di konsol Google reCAPTCHA, daftarkan domain situs (Settings → Domains), mis.:
#   iotsimalas.my.id
#   www.iotsimalas.my.id
#   103.63.24.114.nip.io  (opsional, untuk testing VPS)
# Kosongkan RECAPTCHA_SITE_KEY & RECAPTCHA_SECRET_KEY di local untuk bypass validasi.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Gemini — AI Helpdesk landing (gratis di https://aistudio.google.com/apikey)
# Tanpa key: helpdesk pakai FAQ lokal. Isi key lalu: php artisan config:clear
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.6-flash,gemini-flash-latest

# Batas kirim saran (landing publik & akun dosen/mahasiswa) — opsional, default di config/suggestions.php
# SUGGEST_PUBLIC_IP_PER_HOUR=3
# SUGGEST_PUBLIC_EMAIL_PER_DAY=2
# SUGGEST_PUBLIC_DUPLICATE_HOURS=24
# SUGGEST_ACCOUNT_PER_HOUR=8
# SUGGEST_ACCOUNT_PER_DAY=15
# SUGGEST_ACCOUNT_DUPLICATE_HOURS=12

# APK Mobile Mahasiswa (Flutter) — update setelah upload ke public/downloads/
MOBILE_APK_VERSION=1.3.10
MOBILE_APK_VERSION_CODE=15
MOBILE_APK_MIN_VERSION_CODE=4
MOBILE_APK_FILENAME=AIoT-SIMALAS-Mobile.apk
MOBILE_APK_CHANGELOG="Perbaikan notif dobel saat push masuk, peningkatan stabilitas login/CAPTCHA, serta pembaruan tampilan mobile."
MOBILE_APK_FORCE_UPDATE=false

# Firebase Cloud Messaging
# Project Firebase baru: pakai Service Account JSON (tab Service accounts → Generate new private key).
FCM_SERVICE_ACCOUNT_PATH=storage/app/firebase-service-account.json
# Opsional jika project_id tidak terbaca dari JSON:
# FCM_PROJECT_ID=simalas-mobile
# Legacy Server Key (project lama saja):
FCM_SERVER_KEY=
